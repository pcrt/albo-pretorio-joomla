<?xml version="1.0" encoding="utf-8"?>
<!--
  Update server di Albo Online.
  Pubblicato via GitHub (raw) e referenziato dal manifest del componente.
  Dichiara la compatibilità con Joomla 5.x e 6.x e il PHP minimo.
  Ogni nuova release aggiunge un blocco <update> con la versione e il download.
-->
<updates>
    <update>
        <name>Albo Online</name>
        <description>Albo Pretorio Online per la PA italiana (Joomla 5 e 6)</description>
        <element>com_alboonline</element>
        <type>component</type>
        <version>1.2.2</version>
        <infourl title="Albo Online">https://github.com/pcrt/albo-pretorio-joomla</infourl>
        <downloads>
            <downloadurl type="full" format="zip">https://github.com/pcrt/albo-pretorio-joomla/releases/download/v1.2.2/com_alboonline-1.2.2.zip</downloadurl>
        </downloads>
        <tags>
            <tag>stable</tag>
        </tags>
        <maintainer>Protocolli Creativi (pcrt)</maintainer>
        <targetplatform name="joomla" version="(5\.[0-9]+|6\.[0-9]+)"/>
        <php_minimum>8.3</php_minimum>
    </update>
